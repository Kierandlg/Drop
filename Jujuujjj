# ─────────────────────────────────────────────────────────────────
# xbbg FETCH HELPERS
# ─────────────────────────────────────────────────────────────────
#
#  xbbg.blp.bdp() returns a DataFrame with:
#    - MultiIndex columns: (ticker, field)   OR
#    - flat columns if single field requested
#
#  We always pass flds=["LAST_PRICE"] and access via .xs() or
#  direct column access depending on xbbg version.
#
#  xbbg handles the blpapi session lifecycle internally —
#  no explicit session.start() / session.stop() needed.
# ─────────────────────────────────────────────────────────────────

def _xbbg_bdp(tickers: list[str], field: str = "LAST_PRICE") -> dict[str, float]:
    """
    Call blp.bdp() via xbbg and return {ticker: value}.
    Handles both single and multi-field DataFrame formats.
    Falls back to NaN on any per-ticker error.
    """
    try:
        df = blp.bdp(tickers=tickers, flds=[field])
        # xbbg returns MultiIndex columns (ticker, field) or flat columns
        # Normalise to a simple {ticker: float} dict
        result = {}
        for ticker in tickers:
            try:
                # Try MultiIndex access first
                if isinstance(df.columns, pd.MultiIndex):
                    val = df.loc[ticker, (ticker, field)]
                else:
                    # Flat index — ticker is the row index
                    col = field.lower()   # xbbg lowercases field names
                    val = df.loc[ticker, col] if col in df.columns else df.iloc[
                        tickers.index(ticker), 0]
                result[ticker] = float(val) if pd.notna(val) else np.nan
            except Exception as e:
                logging.debug(f"Ticker {ticker} parse error: {e}")
                result[ticker] = np.nan
        return result
    except Exception as e:
        logging.warning(f"blp.bdp() call failed: {e}")
        return {t: np.nan for t in tickers}


# ─────────────────────────────────────────────────────────────────
# IN-PROCESS CACHE  (TTL = 60s — avoids hammering BBG on callbacks)
# ─────────────────────────────────────────────────────────────────

_CACHE: dict = {}
CACHE_TTL = 60   # seconds


def _cache_get(key: str):
    if key in _CACHE:
        ts, val = _CACHE[key]
        if (datetime.now() - ts).total_seconds() < CACHE_TTL:
            return val
    return None


def _cache_set(key: str, val):
    _CACHE[key] = (datetime.now(), val)
    return val


