@app.callback(
    Output("basis", "figure"),
    Input("tick", "n_intervals"), Input("refresh", "n_clicks"),
)
def update_basis(_, clicks):
    tenors = np.linspace(1, 30, 80)
    fig    = go.Figure()
    for i, pair in enumerate(XCCY_PAIRS):
        basis = get_xccy_basis(pair)
        col   = COLORS5[i % len(COLORS5)]
        fig.add_trace(go.Scatter(
            x=list(tenors),
            y=[interp(basis, t) for t in tenors],
            mode="lines", name=pair,
            line=dict(color=col, width=2),
            fill="tozeroy",
            fillcolor=col.replace(")", ",0.07)").replace("rgb", "rgba"),
            hovertemplate=f"{pair} %{{x:.1f}}Y: %{{y:.1f}} bps<extra></extra>",
        ))
    fig.add_hline(y=0, line_color=GRID_CLR, line_dash="dash")
    fig.update_layout(**_base("Basis (bps)"))
    fig.update_xaxes(title_text="Tenor (years)")
    return fig


@app.callback(
    Output("table", "children"),
    Input("inst", "value"), Input("horizon", "value"),
    Input("min-cr", "value"), Input("ccy-filter", "value"),
    Input("tick", "n_intervals"), Input("refresh", "n_clicks"),
)
def update_table(inst, h, min_cr, ccy_filter, _, clicks):
    if inst == "IRS":
        df   = build_irs_table(h)
        cols = ["Ccy","Tenor","Horizon","SR(%)","Fixing(%)",
                "Carry(bps)","Roll(bps)","Total(bps)","DV01"]
    else:
        df   = build_xccy_table(h)
        cols = ["Pair","Tenor","Horizon","Basis(bps)",
                "Carry(bps)","Roll(bps)","Total(bps)"]
    df = df[df["Total(bps)"] >= min_cr].sort_values("Total(bps)", ascending=False)
    df = df[cols].reset_index(drop=True)
    return dash_table.DataTable(
        data=df.to_dict("records"),
        columns=[{"name": c, "id": c} for c in df.columns],
        sort_action="native", filter_action="native", page_size=20,
        style_table={"overflowX": "auto"},
        style_header={"background": "#0a1628", "color": "#8899aa",
                      "fontSize": "10px", "letterSpacing": "1.5px",
                      "textTransform": "uppercase",
                      "border": f"1px solid {GRID_CLR}", **_mono},
        style_data={"background": BG_CARD, "color": TXT,
                    "border": f"1px solid {GRID_CLR}", **_mono, "fontSize": "12px"},
        style_data_conditional=[
            {"if": {"filter_query": "{Total(bps)} > 10"},
             "color": ACCENT, "fontWeight": "700"},
            {"if": {"filter_query": "{Total(bps)} > 0 && {Total(bps)} <= 10"},
             "color": "#a5d6a7"},
            {"if": {"filter_query": "{Total(bps)} < 0"},
             "color": ACCENT2},
            {"if": {"state": "selected"},
             "background": "#1a2a3a", "border": f"1px solid {ACCENT}"},
        ],
        style_filter={"background": "#0a1628", "color": TXT,
                      "border": f"1px solid {GRID_CLR}"},
    )


