# ─────────────────────────────────────────────────────────────────
# CARRY & ROLL MATH
# ─────────────────────────────────────────────────────────────────

def interp(curve: dict, tenor: float) -> float:
    t = sorted(curve.keys())
    r = [curve[x] for x in t]
    return float(np.interp(tenor, t, r))


def carry_irs(curve: dict, tenor_y: float, horizon_m: float,
              fixing: float, dv01: float) -> float:
    """Eq. 1a — Nordea. Returns bps annualised."""
    sr       = interp(curve, tenor_y)
    coverage = horizon_m / 12
    carry_fv = (sr - fixing) / 100 * coverage
    return round(carry_fv / (dv01 / 10_000) * 100 * 100, 2)


def roll_irs(curve: dict, tenor_y: float, horizon_m: float) -> float:
    """Eq. 2a — spot starting. Returns bps."""
    return round((interp(curve, tenor_y)
                  - interp(curve, tenor_y - horizon_m / 12)) * 100, 2)


def carry_roll_xccy(basis: dict, tenor_y: float, horizon_m: float) -> dict:
    """Carry = B(T), Roll = B(T-H) - B(T). Returns bps."""
    b_now  = interp(basis, tenor_y)
    b_fwd  = interp(basis, max(tenor_y - horizon_m / 12, 0.25))
    carry  = round(b_now, 2)
    roll   = round(b_fwd - b_now, 2)
    return {"carry": carry, "roll": roll, "total": round(carry + roll, 2)}


