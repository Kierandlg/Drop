@app.callback(
    Output("kpis", "children"),
    Input("inst", "value"), Input("horizon", "value"),
    Input("tick", "n_intervals"), Input("refresh", "n_clicks"),
)
def update_kpis(inst, h, _, clicks):
    df       = build_irs_table(h) if inst == "IRS" else build_xccy_table(h)
    best     = df.nlargest(1, "Total(bps)").iloc[0]
    avg      = df["Total(bps)"].mean()
    pct      = (df["Total(bps)"] > 0).mean() * 100
    best_lbl = f"{best.get('Ccy', best.get('Pair',''))} {best['Tenor']}"
    return dbc.Row([
        dbc.Col(kpi("Best Opportunity", f"{best['Total(bps)']} bps", best_lbl, ACCENT), width=3),
        dbc.Col(kpi("Avg Total C+R",    f"{avg:.1f} bps", f"{inst} universe", "#4fc3f7"), width=3),
        dbc.Col(kpi("% Positive",       f"{pct:.0f}%",    "of universe",       "#a5d6a7"), width=3),
        dbc.Col(kpi("Horizon",          f"{h}M",          "roll & carry window", ACCENT2), width=3),
    ], className="g-3")


