def get_irs_curve(ccy: str) -> dict[float, float]:
    """Returns {tenor_y: rate_%} for the IRS par swap curve."""
    key = f"irs_{ccy}"
    if (cached := _cache_get(key)):
        return cached

    if BBG_AVAILABLE:
        ticker_map = IRS_TICKERS.get(ccy, {})
        raw = _xbbg_bdp(list(ticker_map.values()))
        curve = {
            tenor: raw[ticker]
            for tenor, ticker in ticker_map.items()
            if not np.isnan(raw.get(ticker, np.nan))
        }
        if len(curve) >= 4:   # need at least 4 points to be useful
            logging.info(f"IRS {ccy}: {len(curve)} points loaded from BBG")
            return _cache_set(key, curve)
        logging.warning(f"IRS {ccy}: insufficient BBG data ({len(curve)} pts), using stub")

    return _cache_set(key, _stub_irs(ccy))


def get_fixing(ccy: str) -> float:
    """Returns the overnight/short fixing rate (%) for carry calculation."""
    key = f"fix_{ccy}"
    if (cached := _cache_get(key)) is not None:
        return cached

    if BBG_AVAILABLE:
        ticker = FIXING_TICKERS.get(ccy)
        if ticker:
            raw = _xbbg_bdp([ticker])
            val = raw.get(ticker, np.nan)
            if not np.isnan(val):
                logging.info(f"Fixing {ccy}: {val:.4f}% from BBG ({ticker})")
                return _cache_set(key, float(val))

    stub_val = _STUB_FIXINGS.get(ccy, 3.0)
    logging.warning(f"Fixing {ccy}: using stub {stub_val}%")
    return _cache_set(key, stub_val)


def get_xccy_basis(pair: str) -> dict[float, float]:
    """Returns {tenor_y: basis_bps} for the XCCY basis curve."""
    key = f"xccy_{pair}"
    if (cached := _cache_get(key)):
        return cached

    if BBG_AVAILABLE:
        ticker_map = XCCY_TICKERS.get(pair, {})
        raw = _xbbg_bdp(list(ticker_map.values()))
        curve = {
            tenor: raw[ticker]
            for tenor, ticker in ticker_map.items()
            if not np.isnan(raw.get(ticker, np.nan))
        }
        if len(curve) >= 3:
            logging.info(f"XCCY {pair}: {len(curve)} points loaded from BBG")
            return _cache_set(key, curve)
        logging.warning(f"XCCY {pair}: insufficient BBG data, using stub")

    return _cache_set(key, _stub_xccy(pair))


def invalidate_cache():
    """Force-clear all cached data (called on manual refresh)."""
    _CACHE.clear()
    logging.info("Cache cleared — next fetch will hit BBG")


