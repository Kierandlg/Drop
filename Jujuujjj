# TABLE BUILDERS
# ─────────────────────────────────────────────────────────────────

CCYS       = ["EUR", "USD", "GBP", "JPY", "CAD"]
XCCY_PAIRS = ["EUR/USD", "GBP/USD", "JPY/USD", "EUR/GBP", "CAD/USD"]
IRS_TENORS = [2, 3, 5, 7, 10, 15, 20, 30]
DV01_APPROX = {t: t * 92 for t in IRS_TENORS}


def build_irs_table(horizon_m: int = 6) -> pd.DataFrame:
    rows = []
    for ccy in CCYS:
        curve  = get_irs_curve(ccy)
        fixing = get_fixing(ccy)
        for t in IRS_TENORS:
            dv01  = DV01_APPROX[t]
            c     = carry_irs(curve, t, horizon_m, fixing, dv01)
            r     = roll_irs(curve, t, horizon_m)
            rows.append({
                "Ccy":       ccy,
                "Tenor":     f"{t}Y",
                "Horizon":   f"{horizon_m}M",
                "SR(%)":     round(interp(curve, t), 3),
                "Fixing(%)": round(fixing, 3),
                "Carry(bps)": c,
                "Roll(bps)":  r,
                "Total(bps)": round(c + r, 2),
                "DV01":       dv01,
            })
    return pd.DataFrame(rows)


def build_xccy_table(horizon_m: int = 6) -> pd.DataFrame:
    rows = []
    for pair in XCCY_PAIRS:
        basis = get_xccy_basis(pair)
        for t in [2, 3, 5, 7, 10, 15, 20]:
            res = carry_roll_xccy(basis, t, horizon_m)
            rows.append({
                "Pair":       pair,
                "Tenor":      f"{t}Y",
                "Horizon":    f"{horizon_m}M",
                "Basis(bps)": round(interp(basis, t), 2),
                "Carry(bps)": res["carry"],
                "Roll(bps)":  res["roll"],
                "Total(bps)": res["total"],
            })
    return pd.DataFrame(rows)


def build_heatmap(inst: str, horizon_m: int) -> pd.DataFrame:
    if inst == "IRS":
        df    = build_irs_table(horizon_m)
        pivot = df.pivot_table(index="Ccy", columns="Tenor", values="Total(bps)")
        order = [f"{t}Y" for t in IRS_TENORS if f"{t}Y" in pivot.columns]
        return pivot[order]
    df    = build_xccy_table(horizon_m)
    pivot = df.pivot_table(index="Pair", columns="Tenor", values="Total(bps)")
    return pivot


