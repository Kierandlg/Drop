@app.callback(
    Output("curve", "figure"),
    Input("inst", "value"), Input("ccy-filter", "value"),
    Input("tick", "n_intervals"), Input("refresh", "n_clicks"),
)
def update_curve(inst, ccy_filter, _, clicks):
    tenors = np.linspace(0.25, 30, 100)
    fig    = go.Figure()
    for i, ccy in enumerate(CCYS):
        if ccy_filter and ccy not in ccy_filter:
            continue
        curve = get_irs_curve(ccy)
        fig.add_trace(go.Scatter(
            x=list(tenors),
            y=[interp(curve, t) for t in tenors],
            mode="lines", name=ccy,
            line=dict(color=COLORS5[i % len(COLORS5)], width=2),
            hovertemplate=f"{ccy} %{{x:.1f}}Y: %{{y:.3f}}%<extra></extra>",
        ))
    fig.update_layout(**_base("Swap Rate (%)"))
    fig.update_xaxes(title_text="Tenor (years)")
    return fig


@app.callback(
    Output("scatter", "figure"),
    Input("inst", "value"), Input("horizon", "value"),
    Input("min-cr", "value"),
